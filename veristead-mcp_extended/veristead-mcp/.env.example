# Copy to .env and fill in as you progress through the phases.

# Phase 0/1 -- local server
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Phase 2 -- AWS Bedrock / AgentCore (used for ambiguous-intent interpretation only)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Copy the exact model ID from the Bedrock console's Model catalog -- do
# not guess this, cross-region inference profile IDs vary by model/account.
BEDROCK_MODEL_ID=

# Phase 2 -- Alexa+ OAuth 2.1 / PKCE account linking (GitHub as identity provider)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_BASE_URL=http://localhost:8000
