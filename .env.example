# Copy to .env and fill in as you progress through the phases.

# Phase 0/1 -- local server
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Phase 2 -- AWS Bedrock / AgentCore (used for ambiguous-intent interpretation only)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Phase 2 -- GitHub OAuth via FastMCP GitHubProvider
# Register an OAuth App at https://github.com/settings/developers
# Set Homepage URL = your base URL, Callback URL = <base_url>/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_BASE_URL=http://localhost:8000
