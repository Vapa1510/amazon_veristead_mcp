# Copy to .env and fill in as you progress through the phases.

# Phase 0/1 -- local server
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Phase 2 -- Amazon Bedrock Converse API & Amazon SNS Security Escalation
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Copy the exact model ID from the Bedrock console's Model catalog -- do
# not guess this, cross-region inference profile IDs vary by model/account.
BEDROCK_MODEL_ID=
# Amazon SNS Topic ARN for security-critical escalation alerts (defaults to simulation if omitted)
AWS_SNS_TOPIC_ARN=

# Phase 2 -- Alexa+ OAuth 2.1 / PKCE account linking (GitHub as identity provider)
# Register an OAuth App at https://github.com/settings/developers
# Set Homepage URL = your base URL, Callback URL = <base_url>/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_BASE_URL=http://localhost:8000
# Set VERISTEAD_ENV=production or REQUIRE_AUTH=true to enforce strict authentication (fails hard if OAuth is unconfigured)
VERISTEAD_ENV=development
REQUIRE_AUTH=false

# Phase 3 -- AWS CloudWatch Logs Audit Trail (defaults to hermetic simulation ledger if omitted)
AWS_CLOUDWATCH_LOG_GROUP=/veristead/execution-audit
AWS_CLOUDWATCH_LOG_STREAM=audit-trail

